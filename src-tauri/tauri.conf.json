{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blind Guardian",
  "version": "0.1.0-alpha",
  "identifier": "com.raphaeltw.blind-guardian",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Blind Guardian",
        "width": 880,
        "height": 620,
        "minWidth": 640,
        "minHeight": 450,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["resources/blind-guardian-service.exe"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": false,
        "languages": ["PortugueseBR"],
        "compression": "lzma"
      },
      "webviewInstallMode": { "type": "offlineInstaller" }
    }
  }
}
